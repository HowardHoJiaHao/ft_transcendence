# Real secrets are stored in Infisical and injected by `make setup`.
# Keep these entries empty; never commit live values.
DB_PASSWORD=
JWT_SECRET=
ADMIN_PASSWORD_HASH=
BREVO_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_TEST_CONNECTED_ACCOUNT_ID=
STRIPE_TEST_SELLER_EMAIL=
# STRIPE_WEBHOOK_SECRET is generated at runtime by make setup.

# Non-secret runtime configuration
ENVIRONMENT=development
NODE_ENV=development
SERVER_PORT=8080

DB_HOST=db
DB_PORT=5432
DB_NAME=transcendence
DB_USER=transcendence

ADMIN_USERNAME=wongdakfat

# MVP administrator login at /admin/login.
# A bcrypt hash is preferred. The MVP backend also accepts plaintext here for
# local testing, so these example credentials are admin / admin123.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=admin123

# Email OTP provider (required for login OTP and password-change OTP).
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SMTP_KEY=replace-with-your-brevo-smtp-key-if-used

# Optional Google OAuth configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://localhost:8443/api/v1/auth/google/callback
FRONTEND_URL=https://localhost:8443
STRIPE_SUCCESS_URL=https://localhost:8443/cart?checkout=stripe-return&session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=https://localhost:8443/cart?checkout=stripe-cancelled

# RacketBot chat provider.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# Browser API requests are same-origin in Docker. Set this only when building
# the frontend for a different development origin.
NEXT_PUBLIC_API_URL=

# Promtail Docker log collection. Make commands detect these automatically from
# the active Docker context. Set both only to override that detection, e.g.:
# DOCKER_SOCKET_PATH=/run/user/1000/docker.sock
# DOCKER_CONTAINERS_PATH=/home/your-user/.local/share/docker/containers
DOCKER_SOCKET_PATH=
DOCKER_CONTAINERS_PATH=
