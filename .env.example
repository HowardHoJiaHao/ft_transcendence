# Local fallback for the Infisical secrets. Copy to .env, fill in, chmod 600.
# Easiest: run `make env-backup` while Infisical still works instead.
# Use single quotes around values containing $ (e.g. the bcrypt hash).
# Never commit .env or put real values in this file.

# Required
DB_USER=transcendence
DB_NAME=transcendence
DB_PASSWORD=
JWT_SECRET=
ADMIN_PASSWORD_HASH=''
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=

# Stripe sandbox (required by make setup / up / restart)
STRIPE_SECRET_KEY=
STRIPE_TEST_CONNECTED_ACCOUNT_ID=
STRIPE_TEST_SELLER_EMAIL=
STRIPE_SUCCESS_URL='https://localhost:8443/cart?checkout=stripe-return&session_id={CHECKOUT_SESSION_ID}'
STRIPE_CANCEL_URL='https://localhost:8443/cart?checkout=stripe-cancelled'

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=

# Monitoring
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
DISCORD_WEBHOOK_URL=

# Optional (needed for 2FA / password-change email)
BREVO_API_KEY=
