# Copy this file to .env before running the project:
#   cp .env.example .env
# Replace all placeholder keys before using non-local services.

# Runtime and database
ENVIRONMENT=development
NODE_ENV=development
SERVER_PORT=8080
NEXT_PUBLIC_API_URL=https://localhost
DB_HOST=db
DB_PORT=5432
DB_NAME=transcendence
DB_USER=transcendence
DB_PASSWORD=transcendence_pass
DB_ROOT_PASSWORD=transcendence_pass

# Backend authentication: use a random value of at least 32 characters.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# MVP administrator login at /admin/login.
# A bcrypt hash is preferred. The MVP backend also accepts plaintext here for
# local testing, so these example credentials are admin / admin123.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=admin123

# Email OTP provider (required for login OTP and password-change OTP).
BREVO_API_KEY=replace-with-your-brevo-api-key
BREVO_SMTP_KEY=replace-with-your-brevo-smtp-key-if-used

# Optional Google OAuth configuration.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URL=https://localhost/api/v1/auth/google/callback
FRONTEND_URL=https://localhost

# RacketBot chat provider.
DEEPSEEK_API_KEY=replace-with-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# RacketBot embeddings provider.
OPENROUTER_API_KEY=replace-with-your-openrouter-api-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_EMBEDDING_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free
